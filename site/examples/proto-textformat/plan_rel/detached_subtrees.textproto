# The ProjectRel input and expression are stored as separate protobuf chunks.
# Resolving both references is equivalent to placing their values inline.

root {
  input {
    project {
      input {
        detached_reference {
          detached_rel_ordinal: 0
        }
      }
      expressions {
        detached_reference {
          detached_expression_ordinal: 0
        }
      }
    }
  }
}
detached_rels {
  read {
    named_table {
      names: "example"
    }
  }
}
detached_expressions {
  literal {
    i64: 42
  }
}