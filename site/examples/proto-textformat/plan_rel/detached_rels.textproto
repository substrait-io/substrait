# The relation below RelRoot is stored as a separate protobuf chunk.
# Resolving the ordinal is equivalent to placing the ReadRel inline.

root {
  input {
    detached_rel_ordinal: 0
  }
  names: "value"
}
detached_rels {
  read {
    common { direct {} }
    base_schema {
      names: "value"
      struct {
        types { i64 { nullability: NULLABILITY_REQUIRED } }
        nullability: NULLABILITY_REQUIRED
      }
    }
    named_table {
      names: "example"
    }
  }
}