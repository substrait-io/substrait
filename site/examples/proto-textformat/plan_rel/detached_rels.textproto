# The relation below RelRoot is stored as a separate protobuf chunk.
# Resolving the ordinal is equivalent to placing the ReadRel inline.
# Entry 0 is unused and retained so the live reference stays at ordinal 1.

root {
  input {
    detached_rel_ordinal: 1
  }
}
detached_rels {
  read {
    named_table {
      names: "unused"
    }
  }
}
detached_rels {
  read {
    named_table {
      names: "example"
    }
  }
}