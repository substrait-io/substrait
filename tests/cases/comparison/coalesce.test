### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_comparison

# basic: Basic examples without any special cases
coalesce(1::i8, 2::i8) = 1::i8
coalesce(null::i8?, 2::i8) = 2::i8?
coalesce(null::i16?, null::i16?) = null::i16?
coalesce(2000000::i32, null::i32?) = 2000000::i32?
coalesce(null::i64?, 9223372036854775807::i64) = 9223372036854775807::i64?
coalesce(null::fp32?, -65.500000::fp32) = -65.500000::fp32?
coalesce(inf::fp64, -inf::fp64) = inf::fp64
coalesce(7::dec<38, 0>, 4::dec<38, 0>) = 7::dec<38, 0>
coalesce(null::dec?<38, 0>, 2::dec<38, 0>) = 2::dec?<38, 0>
coalesce(null::dec?<38, 0>, null::dec?<38, 0>) = null::dec?<38, 0>
coalesce(2000000::dec<38, 0>, null::dec?<38, 0>) = 2000000::dec?<38, 0>
coalesce(null::dec?<38, 0>, 2000000::dec<38, 0>) = 2000000::dec?<38, 0>

# uuid: UUID literals preserve all 128 bits
coalesce(00112233-4455-6677-8899-aabbccddeeff::uuid, ffffffff-ffff-ffff-ffff-ffffffffffff::uuid) = 00112233-4455-6677-8899-aabbccddeeff::uuid
coalesce(null::uuid?, 00112233-4455-6677-8899-AaBbCcDdEeFf::uuid) = 00112233-4455-6677-8899-AaBbCcDdEeFf::uuid?
coalesce(00000000-0000-0000-0000-000000000000::uuid, null::uuid?) = 00000000-0000-0000-0000-000000000000::uuid?
coalesce(01234567-89ab-cdef-0123-456789abcdef::uuid, null::uuid?) = 01234567-89ab-cdef-0123-456789abcdef::uuid?
coalesce(null::uuid?, null::uuid?) = null::uuid?
